# 构建产物
build/
.cache/

# 本地配置备份（sdkconfig 本体入库：它是实测通过的配置）
sdkconfig.old
sdkconfig.defaults.old
sdkconfig.bak-*

# 托管组件：由 idf_component.yml + dependencies.lock 复原
# 注意：首次编译后需执行 `python tools/apply_patch.py` 打摄像头补丁
managed_components/

# 补丁应用时自动备份的原厂文件
*.c.orig

# 编辑器与 IDE 配置（含本机路径，不入库）
.vscode/
.clangd
*.code-workspace

# 系统
.DS_Store
Thumbs.db

# 串口调试抓取的临时数据
_tmp_*.bin
logs/
